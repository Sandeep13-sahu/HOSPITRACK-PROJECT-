# ==============================================================================
# HOSPITRACK PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure values before running in production.
# NEVER commit .env files containing real production credentials.

# ------------------------------------------------------------------------------
# Backend Spring Boot Configuration
# ------------------------------------------------------------------------------
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Production Database URL
DATABASE_URL=jdbc:postgresql://localhost:5432/hospitrack
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_postgresql_password_here

# JWT Authentication Signing Key (must be at least 256 bits / 32 characters)
JWT_SECRET=your_super_secret_jwt_signing_key_change_in_production_2026
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Frontend Origins (comma-separated, no wildcard with credentials)
FRONTEND_URL=http://localhost:8000,http://localhost:5173

# ------------------------------------------------------------------------------
# Brevo Transactional Email Service (Backend Only)
# ------------------------------------------------------------------------------
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=no-reply@yourdomain.com
BREVO_SENDER_NAME=Hospitrack Healthcare System

# ------------------------------------------------------------------------------
# Controlled Initial Administrator Bootstrap
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=YourStrongAdminPassword2026!

# ------------------------------------------------------------------------------
# Frontend Client Configuration
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
